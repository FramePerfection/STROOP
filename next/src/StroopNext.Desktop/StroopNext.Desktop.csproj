<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <RootNamespace>StroopNext.Desktop</RootNamespace>
        <AssemblyName>StroopNext.Desktop</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\..\..\STROOP\icon.ico</ApplicationIcon>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
        <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Headless" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Legacy STROOP's object images (Mario panel, held objects): copied next to the app, loaded on demand. -->
        <Content Include="..\..\..\STROOP\Resources\Object Images\*.png" LinkBase="Assets\Object Images" CopyToOutputDirectory="PreserveNewest" Visible="false"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\StroopNext.Core\StroopNext.Core.csproj"/>
        <ProjectReference Include="..\StroopNext.Rendering\StroopNext.Rendering.csproj"/>
        <ProjectReference Include="..\StroopNext.Platform\StroopNext.Platform.csproj"/>
    </ItemGroup>
</Project>
